{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RaaS Documentation",
  "colors": {
    "primary": "#0d9488",
    "light": "#2dd4bf",
    "dark": "#0f766e"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@leapfinancial.com"
      }
    ]
  },
  "navigation": {
    "products": [
      {
        "product": "RaaS",
        "description": "Partner APIs for remittance-as-a-service: users, funding, corridors, and operations.",
        "icon": "money-bill-transfer",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "raas/index",
                  "raas/quickstart",
                  "raas/authentication"
                ]
              },
              {
                "group": "Guides",
                "pages": [
                  "raas/guides/testing-sandbox"
                ]
              }
            ]
          },
          {
            "tab": "Partner ASK API Reference",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "raas/api-reference/introduction",
                  "raas/api-reference/partner-webhooks"
                ]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "raas/swagger-partner.json",
                  "directory": "partner"
                }
              }
            ]
          },
          {
            "tab": "Partner Widget Ask API Reference",
            "openapi": {
              "source": "raas/swagger-partner-widget-ask.json",
              "directory": "partner-widget-ask"
            }
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Support",
          "href": "mailto:support@leapfinancial.com",
          "icon": "envelope"
        }
      ]
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor"]
  },
  "footer": {
    "socials": {
      "linkedin": "https://leapfinancial.com"
    }
  },
  "api": {
    "baseUrl": "https://raas-partner-cv.nomas.cash/v1",
    "openapi": "raas/swagger.json",
    "mdx": {
      "server": "https://raas-partner-cv.nomas.cash/v1"
    }
  }
}
